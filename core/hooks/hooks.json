{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 10,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"
      ],
      "onFailure": "block"
     }
    ]
   },
   {
    "matcher": "Agent|Task",
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py",
       "hook"
      ]
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "matcher": "Edit|Write|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 10,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/hooks/rules_check.py"
      ]
     }
    ]
   },
   {
    "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Glob|Agent|Task|Skill|WebFetch|WebSearch",
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py",
       "hook"
      ],
      "async": true
     }
    ]
   }
  ],
  "SubagentStop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py",
       "hook"
      ],
      "async": true
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/hooks/flow_check.py",
       "prompt"
      ]
     }
    ]
   }
  ],
  "SessionEnd": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py",
       "hook"
      ]
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 5,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/hooks/flow_check.py",
       "stop"
      ]
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python",
      "timeout": 10,
      "args": [
       "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"
      ]
     }
    ]
   }
  ]
 }
}
