{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit",
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
      "timeout": 10
     }
    ]
   },
   {
    "matcher": "Agent|Task",
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py\" hook",
      "timeout": 5
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "matcher": "Edit|Write|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_check.py\"",
      "timeout": 10
     }
    ]
   },
   {
    "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Glob|Agent|Task|Skill|WebFetch|WebSearch",
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py\" hook",
      "timeout": 5
     }
    ]
   }
  ],
  "SubagentStop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/live_status.py\" hook",
      "timeout": 5
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/flow_check.py\" prompt",
      "timeout": 5
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/flow_check.py\" stop",
      "timeout": 5
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
      "timeout": 10
     }
    ]
   }
  ]
 }
}
